# General
APP_NAME=Kauri
APP_ENV=development

# API
API_BASE_URL=https://api.kauri-app.com/api/v1

# Telemetry (OpenTelemetry)
# URL of your OTEL Collector (HTTP). Port 4318 is standard for HTTP/Protobuf.
# Example: http://192.168.1.15:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector:4318/v1/traces
