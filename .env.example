# ============================================================
# ⚠️ FICHIER OBSOLÈTE — NON LU PAR L'APPLICATION.
# Ce projet n'utilise aucune dépendance flutter_dotenv : ce fichier (et
# son pendant `.env` à la racine) ne sont lus par AUCUN code Dart au
# runtime. La configuration réelle passe par `--dart-define-from-file`
# — voir `dart_defines.example.json` et le README.md § Démarrage rapide.
# Conservé uniquement à titre indicatif/historique.
# ============================================================

# General
APP_NAME=Kauri
APP_ENV=development

# API
API_BASE_URL=https://your-api-url/api/v1

# Telemetry (OpenTelemetry)
# URL of your OTEL Collector (HTTP). Port 4318 is standard for HTTP/Protobuf.
# Example: http://192.168.1.182:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector:4318/v1/traces
API_LOGS_ENDPOINT=http://your-otel-collector:3000/api/v1/system/telemetry/logs
