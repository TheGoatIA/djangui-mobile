# Standard Flutter Podfile boilerplate
require File.expand_path(File.join('Flutter', 'podhelper.rb'), File.dirname(__FILE__))

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Fix for Bitcode
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Set Deployment Target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      
      # Additional compiler flags for permissions
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', 'PERMISSION_CAMERA=1', 'PERMISSION_PHOTOS=1', 'PERMISSION_NOTIFICATIONS=1']
      
      # Fix for IPP / IOKit missing headers on some runners
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
    end
  end
end
