<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Désactivation globale du trafic HTTP en clair (K-08) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- SPKI Pinning (K-08) sur le domaine API Kauri, propriété de l'équipe.
         Pins sur l'intermédiaire ET la racine Let's Encrypt (pas le certificat
         feuille, qui tourne tous les ~90 jours) pour survivre au renouvellement
         de routine sans mise à jour d'app, tout en bloquant un certificat émis
         par une AC MITM/rogue (proxy d'entreprise, Burp, AC compromise).
         Valeurs extraites en direct de la chaîne TLS de production le
         2026-08-24 (openssl s_client -connect api.kauri-app.com:443 -showcerts).
         À REVALIDER si api.kauri-app.com change d'autorité de certification. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.kauri-app.com</domain>
        <pin-set expiration="2028-08-24">
            <!-- Intermédiaire Let's Encrypt "YE2" (expire 2028-09-02) -->
            <pin digest="SHA-256">s/tdAOmUzd8syaTuqfgGvFcn6DzA5Cmb+Vby1ST+U3Y=</pin>
            <!-- Racine "ISRG Root X2" (expire 2032-09-02) — repli si LE change d'intermédiaire -->
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
            <!-- Certificat feuille courant, en défense supplémentaire jusqu'à son renouvellement -->
            <pin digest="SHA-256">vukYK1YHRj+pETqo5SuPkBe8o6p5zYwUfsSfpNo7iDg=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Prestataires de paiement tiers : trafic chiffré exigé, mais SANS pin-set.
         Épingler l'infrastructure TLS d'un tiers qu'on ne contrôle pas
         (multi-CA/CDN, rotation hors de notre calendrier) est un anti-pattern
         documenté qui provoque des pannes de paiement — cf. les
         recommandations de Stripe elles-mêmes contre le pinning de leurs domaines. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.notchpay.co</domain>
        <domain includeSubdomains="true">api.stripe.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Configuration de débogage local uniquement en mode dev -->
    <!-- PROFILE UNIQUEMENT (mesures de performance sur émulateur ; jamais publié :
         les builds release utilisent la config de production de src/main) :
         HTTP en clair autorisé vers l'API de test locale, joignable depuis
         l'émulateur Android via 10.0.2.2 (= localhost de la machine hôte). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
